# Mismo proyecto de Supabase que la web actual (ver web/README.md).
# La anon key es pública por diseño; la service role NUNCA lleva prefijo NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# Fourvenues (Channel Manager). SOLO servidor, jamás NEXT_PUBLIC_.
# Mientras no exista clave se usa el adapter simulado.
FOURVENUES_ADAPTER=mock
# FOURVENUES_API_KEY=
# FOURVENUES_BASE_URL=https://channels-service-alpha.fourvenues.com
